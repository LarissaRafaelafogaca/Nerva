{
  "name": "DoseLog",
  "type": "object",
  "properties": {
    "medication_id": {
      "type": "string",
      "description": "Reference to the Medication"
    },
    "medication_name": {
      "type": "string",
      "description": "Denormalized medication name for display"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "The date the dose was scheduled"
    },
    "scheduled_time": {
      "type": "string",
      "description": "Scheduled time, e.g. 08:00"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "taken",
        "missed",
        "skipped"
      ],
      "default": "pending"
    },
    "taken_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the dose was actually taken"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "medication_id",
    "scheduled_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}