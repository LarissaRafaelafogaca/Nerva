{
  "name": "SideEffect",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "medication_id": {
      "type": "string",
      "description": "Reference to the Medication (optional)"
    },
    "medication_name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Description of the side effect"
    },
    "severity": {
      "type": "string",
      "enum": [
        "mild",
        "moderate",
        "severe"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}