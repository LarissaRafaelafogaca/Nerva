# ================= NERVA BACKEND — variáveis de ambiente =================
# Desenvolvimento: copie para .env e preencha com valores reais. NÃO commite o .env.
# Produção (Railway): configure cada variável no painel Variables do Railway.

# Ambiente
NODE_ENV=production
PORT=4000

# Origem(s) permitida(s) do front-end (separadas por vírgula).
# Em produção: URL do Vercel. Ex.: https://nerva.vercel.app
CORS_ORIGIN=https://SEU-FRONTEND.vercel.app

# Banco de dados PostgreSQL
# No Railway: será preenchida automaticamente ao adicionar o plugin PostgreSQL.
DATABASE_URL=postgresql://nerva:nerva@localhost:5432/nerva?schema=public

# JWT — use strings longas e aleatórias em produção
JWT_ACCESS_SECRET=troque-por-um-segredo-forte-de-acesso
JWT_REFRESH_SECRET=troque-por-um-segredo-forte-de-refresh
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# OTP / verificação de e-mail
OTP_EXPIRES_MINUTES=10
PASSWORD_RESET_EXPIRES_MINUTES=30

# SMTP (envio de e-mail). Se vazio, os códigos são apenas logados no console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Nerva <no-reply@nerva.local>"

# Google OAuth
# GOOGLE_CALLBACK_URL em produção: https://SEU-BACKEND.up.railway.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://SEU-BACKEND.up.railway.app/api/auth/google/callback

# URL do front-end (para redirecionar após OAuth)
FRONTEND_URL=https://SEU-FRONTEND.vercel.app

# Timezone da aplicação para o cron de doses
APP_TIMEZONE=America/Sao_Paulo

# E-mail(s) autorizado(s) como administrador (separados por vírgula).
ADMIN_EMAILS=larissarafaelafogaca@gmail.com

# Web Push (VAPID).
# Para gerar novas chaves: node -e "const wp=require('web-push');console.log(wp.generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@nerva.local
