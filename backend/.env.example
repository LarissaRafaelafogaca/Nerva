# ================= NERVA BACKEND — variáveis de ambiente =================
# Copie para .env e preencha com valores reais. NÃO commite o .env.

# Ambiente
NODE_ENV=development
PORT=4000

# Origem(s) permitida(s) do front-end (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://nerva:nerva@localhost:5432/nerva?schema=public

# JWT
JWT_ACCESS_SECRET=troque-por-um-segredo-forte-de-acesso
JWT_REFRESH_SECRET=troque-por-um-segredo-forte-de-refresh
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# OTP / verificação de e-mail
OTP_EXPIRES_MINUTES=10
PASSWORD_RESET_EXPIRES_MINUTES=30

# SMTP (envio de e-mail). Se vazio, os códigos são apenas logados em dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Nerva <no-reply@nerva.local>"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# URL do front-end (para redirecionar após OAuth)
FRONTEND_URL=http://localhost:5173

# Timezone da aplicação para o cron de doses (default UTC)
APP_TIMEZONE=UTC

# E-mail(s) autorizado(s) como administrador (separados por vírgula).
# Qualquer outro usuário é sempre paciente, mesmo que tente forçar via API.
ADMIN_EMAILS=larissa.fogaca@nerva.test

# Web Push (VAPID). Gere com: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@nerva.local
